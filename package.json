{
  "name": "goob",
  "description": "A modular, class-based web data extraction toolkit for Node.js",
  "version": "0.1.0",
  "author": {
    "name": "Irfan Shadik Rishad"
  },
  "scripts": {
    "build": "tsup",
    "bump:major": "npm version major -m \"chore(release): v%s\"",
    "bump:minor": "npm version minor -m \"chore(release): v%s\"",
    "bump:patch": "npm version patch -m \"chore(release): v%s\"",
    "format": "prettier -w ./",
    "prepare": "husky",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tests/tsconfig.json"
  },
  "keywords": [
    "goob",
    "goob-core"
  ],
  "homepage": "https://github.com/irfanshadikrishad/goob#readme",
  "bugs": {
    "url": "https://github.com/irfanshadikrishad/goob/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfanshadikrishad/goob.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "prettier": "@irfanshadikrishad/prettier",
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@irfanshadikrishad/prettier": "^1.3.7",
    "@jest/globals": "^30.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "5.9"
  }
}
